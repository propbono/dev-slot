---
import Layout from "@/layouts/Layout.astro";

const email = Astro.url.searchParams.get("email") ?? "";
const resent = Astro.url.searchParams.get("resent") === "1";
const error = Astro.url.searchParams.get("error");
---

<Layout title="Confirm your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Confirm your email
      </h1>
      <p class="mb-6 text-blue-100/80">
        We sent a confirmation link to your email address. Click it to activate your account, then sign in to continue.
      </p>

      {
        resent && (
          <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
            Confirmation email resent. Check your inbox.
          </p>
        )
      }
      {
        error && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
        )
      }

      <form method="POST" action="/api/auth/resend" class="mb-6 space-y-3">
        <input
          type="email"
          name="email"
          value={email}
          placeholder="you@example.com"
          required
          class="w-full rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm text-white placeholder-blue-100/40 transition-colors outline-none focus:border-purple-400"
        />
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Resend confirmation email
        </button>
      </form>

      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">Back to sign in</a>
    </div>
  </div>
</Layout>
