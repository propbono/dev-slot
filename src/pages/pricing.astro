---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import PricingGrid from "@/components/PricingGrid.astro";

const currentRole = Astro.locals.role ?? null;
---

<Layout title="Pricing — Archdrill">
  <div class="bg-cosmic relative min-h-screen w-full">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <div class="mx-auto max-w-4xl px-4 py-16">
        <h1 class="mb-4 text-center text-3xl font-bold text-white sm:text-4xl">Pricing</h1>
        <p class="mb-12 text-center text-blue-100/60">Start free, upgrade when you're ready.</p>
        <PricingGrid currentRole={currentRole} />
        <p class="mt-10 text-center text-sm text-blue-100/50">
          Questions?{" "}
          <a href="mailto:support@archdrill.com" class="text-purple-300 transition-colors hover:text-purple-200">
            support@archdrill.com
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
