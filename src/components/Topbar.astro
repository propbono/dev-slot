---
import Logo from "@/components/Logo.astro";
import { TIER_LABELS, type TierRole } from "@/lib/tiers";

const { user } = Astro.locals;
const role: TierRole = Astro.locals.role ?? "user";
const canUpgrade = role === "user" || role === "pro";
---

<header
  class="mb-4 flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/5 px-4 py-2.5 backdrop-blur-xl sm:px-5"
>
  <Logo />
  {
    user ? (
      <div class="flex items-center gap-3">
        <a
          href="/account"
          title="Your plan"
          class="inline-flex items-center rounded-full border border-purple-400/40 bg-purple-500/15 px-3 py-1 text-xs font-medium text-purple-200 transition-colors hover:bg-purple-500/25"
        >
          {TIER_LABELS[role]}
        </a>
        {canUpgrade && (
          <a
            href="/pricing"
            class="inline-flex items-center rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium text-white shadow-lg shadow-purple-950/40 transition-colors hover:bg-purple-500"
          >
            Upgrade
          </a>
        )}
        <span class="hidden max-w-[16rem] truncate text-sm text-blue-100/70 sm:inline">{user.email}</span>
        <a
          href="/new-session"
          class="inline-flex items-center rounded-lg border border-white/15 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-white/10"
        >
          New Session
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm font-medium text-blue-100/70 transition-colors hover:bg-white/10 hover:text-white"
          >
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex items-center gap-2">
        <a
          href="/auth/signin"
          class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm font-medium text-blue-100/70 transition-colors hover:bg-white/10 hover:text-white"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="inline-flex items-center rounded-lg bg-purple-600 px-4 py-1.5 text-sm font-medium text-white shadow-lg shadow-purple-950/40 transition-colors hover:bg-purple-500"
        >
          Sign up
        </a>
      </div>
    )
  }
</header>
