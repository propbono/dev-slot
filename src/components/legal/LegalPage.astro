---
import Layout from "@/layouts/Layout.astro";

type Props = {
  title: string;
  lastUpdated: string;
};

const { title, lastUpdated } = Astro.props;
---

<Layout title={`${title} — Archdrill`}>
  <div class="bg-cosmic min-h-screen w-full text-white">
    <div class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm text-blue-100/60 transition-colors hover:text-purple-300"
      >
        <span aria-hidden="true">&larr;</span> Back to Archdrill
      </a>

      <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>

      <p class="mt-6 text-sm text-blue-100/50">Last updated: {lastUpdated}</p>
      <div class="mt-3 rounded-xl border border-purple-500/20 bg-purple-500/10 px-4 py-3 text-sm text-purple-100/90">
        We may update this page from time to time to reflect changes in our practices or for legal reasons. Material
        changes will be reflected in the “Last updated” date above and, where required by law, communicated to you
        directly.
      </div>

      <div class="legal-prose mt-8">
        <slot />
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-prose {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(219, 234, 254, 0.82);
  }
  .legal-prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(h3) {
    margin-top: 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgb(226, 232, 240);
  }
  .legal-prose :global(p) {
    margin-top: 1rem;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
  }
  .legal-prose :global(ul) {
    list-style: disc;
  }
  .legal-prose :global(ol) {
    list-style: decimal;
  }
  .legal-prose :global(li) {
    margin-top: 0.5rem;
  }
  .legal-prose :global(a) {
    color: rgb(216, 180, 254);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(a:hover) {
    color: rgb(233, 213, 255);
  }
  .legal-prose :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }
</style>
