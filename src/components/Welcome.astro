---
import Topbar from "@/components/Topbar.astro";

const CheckmarkIcon = `<svg class="mt-0.5 h-4 w-4 shrink-0 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>`;
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <!-- Cosmic orbs -->
  <div
    class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-indigo-400/10 blur-[140px]"
  >
  </div>

  <!-- Star field -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px), radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 200px 200px, 150px 150px, 100px 100px; background-position: 0 0, 40px 60px, 80px 30px;"
  >
  </div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-500/10 px-4 py-1.5 text-sm text-purple-200 backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-purple-400"></span>
        </span>
        AI-Powered Interview Practice
      </div>
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        Ace Your Architecture Interview
      </h1>
      <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
        Practice system design interviews with an AI that adapts to you. Paste your target job description, get tailored
        challenges, and receive follow-up questions that escalate when you're strong and drill down when you're weak.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-8 py-3.5 text-base font-medium text-white transition-colors hover:bg-purple-500"
        >
          Start Practicing Free
        </a>
        <a
          href="#how-it-works"
          class="inline-flex items-center justify-center rounded-lg border border-white/20 px-8 py-3.5 text-base font-medium text-white transition-colors hover:bg-white/10"
        >
          See How It Works
        </a>
      </div>
    </div>

    <!-- How It Works -->
    <div id="how-it-works" class="mx-auto max-w-4xl px-4 pb-24">
      <h2 class="mb-12 text-center text-3xl font-bold text-white sm:text-4xl">How It Works</h2>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="relative text-center">
          <div
            class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-purple-600/20 font-mono text-2xl font-bold text-purple-300"
          >
            1
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white">Paste Your Target JD</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Drop in the job description you're aiming for. Our AI extracts the tech stack, role level, and domain to
            tailor everything to your target.
          </p>
        </div>
        <div class="relative text-center">
          <div
            class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-purple-600/20 font-mono text-2xl font-bold text-purple-300"
          >
            2
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white">Solve a Real Challenge</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            Receive a system design challenge crafted specifically for the role. Submit your architectural solution —
            just like in a real interview.
          </p>
        </div>
        <div class="relative text-center">
          <div
            class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-purple-600/20 font-mono text-2xl font-bold text-purple-300"
          >
            3
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white">Get Adaptive Feedback</h3>
          <p class="text-sm leading-relaxed text-blue-100/60">
            The AI evaluates your answer on the spot. Strong? It escalates with adversarial follow-ups. Weak? It drills
            down to help you find your blind spots.
          </p>
        </div>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <path
            d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"
          ></path>
          <path d="M9 21h6"></path>
          <path d="M10 18h4"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">AI-Powered Challenges</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Tailored system design challenges generated from your target job description and tech stack. No generic
          questions — every challenge is role-specific.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
          <path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
          <path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
          <path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Adaptive Follow-Up</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          The AI evaluates your answer in real time. Strong responses get adversarial pressure-testing. Weak ones get
          foundational diagnostic drills to uncover gaps.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
          <line x1="2" y1="20" x2="22" y2="20"></line>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Performance Insights</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Review completed sessions with comprehensive summaries — strengths, improvement areas, and quality ratings.
          Track your progress over time.
        </p>
      </div>
    </div>

    <!-- Pricing -->
    <div class="mx-auto max-w-4xl px-4 pb-24">
      <h2 class="mb-4 text-center text-3xl font-bold text-white sm:text-4xl">Simple Pricing</h2>
      <p class="mb-12 text-center text-blue-100/60">Start free, upgrade when you're ready.</p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <!-- Free -->
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-1 text-lg font-semibold text-white">Free</h3>
          <div class="mb-4">
            <span class="text-3xl font-bold text-white">$0</span>
            <span class="text-sm text-blue-100/50">/month</span>
          </div>
          <ul class="mb-6 space-y-2 text-sm text-blue-100/60">
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              1 interview per month
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              3 turns per challenge
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              1 challenge per session
            </li>
          </ul>
          <a
            href="/auth/signup"
            class="block w-full rounded-lg border border-white/20 bg-white/5 px-4 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-white/10"
          >
            Get Started
          </a>
        </div>

        <!-- Pro -->
        <div class="relative rounded-xl border border-purple-500/30 bg-purple-500/5 p-6 backdrop-blur-xl">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span
              class="inline-flex items-center rounded-full border border-purple-500/30 bg-purple-600/90 px-3 py-0.5 text-xs font-medium text-white backdrop-blur-sm"
            >
              Coming Soon
            </span>
          </div>
          <h3 class="mb-1 text-lg font-semibold text-white">Pro</h3>
          <div class="mb-4">
            <span class="text-3xl font-bold text-white">$10</span>
            <span class="text-sm text-blue-100/50">/month</span>
          </div>
          <ul class="mb-6 space-y-2 text-sm text-blue-100/60">
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              5 interviews per month
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              Unlimited turns per challenge
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              5 challenges per session
            </li>
          </ul>
          <button
            disabled
            class="block w-full cursor-not-allowed rounded-lg bg-purple-600/40 px-4 py-2.5 text-center text-sm font-medium text-purple-200/60"
          >
            Coming Soon
          </button>
        </div>

        <!-- Unlimited -->
        <div class="relative rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span
              class="inline-flex items-center rounded-full border border-purple-500/30 bg-purple-600/90 px-3 py-0.5 text-xs font-medium text-white backdrop-blur-sm"
            >
              Coming Soon
            </span>
          </div>
          <h3 class="mb-1 text-lg font-semibold text-white">Unlimited</h3>
          <div class="mb-4">
            <span class="text-3xl font-bold text-white">$15</span>
            <span class="text-sm text-blue-100/50">/month</span>
          </div>
          <ul class="mb-6 space-y-2 text-sm text-blue-100/60">
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              Unlimited interviews
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              Unlimited turns
            </li>
            <li class="flex items-start gap-2">
              <Fragment set:html={CheckmarkIcon} />
              Unlimited challenges
            </li>
          </ul>
          <button
            disabled
            class="block w-full cursor-not-allowed rounded-lg border border-white/20 bg-white/5 px-4 py-2.5 text-center text-sm font-medium text-blue-100/40"
          >
            Coming Soon
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mx-auto max-w-4xl border-t border-white/10 px-4 py-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-blue-100/40">
          &copy; {new Date().getFullYear()} DevSlot. Built for engineers, by engineers.
        </p>
        <div class="flex gap-6">
          <a href="/auth/signin" class="text-sm text-blue-100/40 transition-colors hover:text-blue-100/70"> Sign In </a>
          <a href="/auth/signup" class="text-sm text-blue-100/40 transition-colors hover:text-blue-100/70"> Sign Up </a>
        </div>
      </div>
    </div>
  </div>
</div>
